                ]
              }
            }
          ]
        },
        {
          "name": "View Deleted Product - Proves Deletion",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            },
            "description": "The final link in the CRUD proof chain: POST -> GET -> PATCH -> GET -> DELETE -> GET = 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 after delete', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Failure Cases",
      "description": "Keep these saved. They prove your validation and error handling work. A professional API must behave predictably when requests are wrong, not only when they are perfect.",
      "item": [
        {
          "name": "Create Product - Missing Name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"No name supplied\",\n  \"price\": 500,\n  \"category\": \"Accessories\",\n  \"stock\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
