                  "const b = pm.response.json();",
                  "pm.test('returns a token', () => pm.expect(b.token).to.be.a('string'));",
                  "if (b.token) pm.collectionVariables.set('token', b.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
