        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1700,\n  \"stock\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            },
            "description": "PATCH is partial. Send only what changes; everything else must stay the same."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('price updated', () => pm.expect(d.price).to.eql(1700));",
                  "pm.test('stock updated', () => pm.expect(d.stock).to.eql(8));",
                  "pm.test('name was NOT wiped by the partial update', () => pm.expect(d.name).to.eql('Mechanical Keyboard'));",
                  "pm.test('category was NOT wiped', () => pm.expect(d.category).to.eql('Accessories'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
