                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('message does not reveal which field was wrong', () => pm.expect(pm.response.json().message.toLowerCase()).to.include('invalid email or password'));"
                ]
              }
            }
          ]
        },
