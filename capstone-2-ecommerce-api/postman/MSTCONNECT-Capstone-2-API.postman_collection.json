                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('only matching category returned', () => {",
                  "  body.data.forEach(p => pm.expect(p.category.toLowerCase()).to.eql('accessories'));",
                  "});"
                ]
